# Used only for judging answers with plain (non-fine-tuning) chat inference.
OPENAI_API_KEY=

# Hugging Face token with "write" access, needed for HF Jobs (create_repo, push_to_hub).
# Create one at https://huggingface.co/settings/tokens after adding a payment method
# at https://huggingface.co/settings/billing (Jobs requires a positive credit balance).
HF_TOKEN=

# Path to the local Q&A dataset (JSONL with "question"/"answer" keys) derived
# from the internal documentation. Proprietary - not part of this repo.
SOURCE_DATASET=
